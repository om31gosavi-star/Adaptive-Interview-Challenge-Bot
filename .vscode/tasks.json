{
    "tasks": [
        {
            "type": "shell",
            "label": "Build Mock Interview Bot (GCC C++17)",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++17",
                "-O2",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/src/main.cpp",
                "-o",
                "${workspaceFolder}/MockInterviewBot.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles MockInterviewBot.exe with GCC (UCRT64) and C++17"
        },
        {
            "type": "shell",
            "label": "Build Mock Interview Bot (MSVC C++17)",
            "command": "cmd.exe",
            "args": [
                "/c",
                "build.bat"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Compiles MockInterviewBot.exe with MSVC x64 and C++17"
        },
        {
            "type": "shell",
            "label": "C/C++: g++.exe build active file",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++17",
                "-g",
                "-I${workspaceFolder}/include",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Compiles active file with GCC"
        }
    ],
    "version": "2.0.0"
}